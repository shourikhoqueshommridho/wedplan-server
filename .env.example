# Copy to .env for local development. Never commit the real .env file.
# Production values are set in the hosting provider dashboard, not in this repo.

# Server
PORT=5000
NODE_ENV=development
# Browser-facing frontend origin. Used for CORS, Checkout redirects and
# production auth URLs. Use the real HTTPS origin in production.
CLIENT_URL=http://localhost:3000

# Automatically injected by Vercel; do not set manually in local development.
# VERCEL_URL=<deployment-host-without-scheme>
# VERCEL_PRODUCTION_URL=<production-host-without-scheme>

# Better Auth (mounted by this API at /api/auth and proxied by the frontend).
# BETTER_AUTH_URL must be the browser-facing origin, not the backend origin.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Google OAuth. The callback registered with Google must be
# ${BETTER_AUTH_URL}/api/auth/callback/google on the browser-facing origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB. Use a replica set (Atlas) in production: transactions are used by
# subscription commit and require one.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=wedplan

# JWT/JWKS. Issuer and audience are identifiers, not secrets, and must match
# the Better Auth JWT plugin on the frontend. JWKS_URL is the public proxied
# path; a localhost value is ignored in production in favour of the browser
# origin's /api/auth/jwks endpoint.
JWT_ISSUER=wedplan
JWT_AUDIENCE=wedplan-api
JWKS_URL=http://localhost:3000/api/auth/jwks

# Stripe (server-only). Never expose these to the browser.
# Register POST <BACKEND_ORIGIN>/api/stripe/webhook in Stripe and forward:
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
# Optional debugging flag; leave unset in production.
# STRIPE_CHECKOUT_DIAGNOSTICS=1

# ImgBB (server-only upload key).
IMGBB_API_KEY=
